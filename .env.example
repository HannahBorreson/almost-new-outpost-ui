# Copy to .env.development.local (or .env.local) to override settings on your machine.

# true  = answer every API call with the in-browser mock data in src/mocks (no backend needed)
# false = send real HTTP requests to VITE_API_BASE_URL
VITE_USE_MOCKS=true

# Base URL of the ASP.NET Core API, including the /api prefix
VITE_API_BASE_URL=https://localhost:7001/api

# Mock mode only: minutes between weather changes (default 5)
VITE_MOCK_WEATHER_MINUTES=5
